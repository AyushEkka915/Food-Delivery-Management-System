# Top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: trailing double-spaces are meaningful line breaks
[*.md]
trim_trailing_whitespace = false

# Backend
[*.java]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4

# Frontend
[*.js]
indent_style = space
indent_size = 2

[*.jsx]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.css]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2
