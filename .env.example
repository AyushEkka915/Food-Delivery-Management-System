# ============================================================================
# Smart Food Delivery Management System - environment template
# Safe to commit. Contains placeholders only, never real secrets.
# ============================================================================

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- MySQL ----
DB_URL=jdbc:mysql://localhost:3306/food_delivery?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=foodapp
DB_PASSWORD=CHANGE_ME

# ---- Security ----
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Pricing (business rules) ----
TAX_PERCENT=5.00
DELIVERY_BASE_FEE=20.00
DELIVERY_PER_KM_FEE=8.00
PLATFORM_COMMISSION_PERCENT=12.00

# ---- Payments (optional sandbox) ----
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws

# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
