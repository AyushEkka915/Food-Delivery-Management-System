{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design token contract for the Smart Food Delivery Management System. design/tokens/tokens.css is the runtime source of truth: the React app and every static artefact read those CSS custom properties. This JSON file is the tooling and documentation mirror only (Figma import, contrast checks, codegen, the component inventory). If a value changes, change tokens.css first and mirror it here in the same commit; these two files must never drift.",
  "color": {
    "brand": {
      "50": { "$value": "#FEF2F3", "$type": "color" },
      "100": { "$value": "#FDE2E4", "$type": "color" },
      "200": { "$value": "#FBC5C9", "$type": "color" },
      "500": { "$value": "#E23744", "$type": "color" },
      "600": { "$value": "#D02B38", "$type": "color" },
      "700": { "$value": "#B01F2B", "$type": "color" },
      "900": { "$value": "#6E1119", "$type": "color" }
    },
    "ink": {
      "900": { "$value": "#111827", "$type": "color" },
      "800": { "$value": "#1C1C1C", "$type": "color" },
      "700": { "$value": "#374151", "$type": "color" },
      "600": { "$value": "#4B5563", "$type": "color" }
    },
    "muted": {
      "500": { "$value": "#6B7280", "$type": "color" },
      "400": { "$value": "#9CA3AF", "$type": "color" }
    },
    "line": {
      "200": { "$value": "#E5E7EB", "$type": "color" },
      "100": { "$value": "#F3F4F6", "$type": "color" }
    },
    "surface": {
      "0": { "$value": "#FFFFFF", "$type": "color" }
    },
    "canvas": {
      "50": { "$value": "#F9FAFB", "$type": "color" },
      "100": { "$value": "#F3F4F6", "$type": "color" }
    },
    "success": {
      "600": { "$value": "#16A34A", "$type": "color" },
      "50": { "$value": "#F0FDF4", "$type": "color" }
    },
    "warning": {
      "600": { "$value": "#D97706", "$type": "color" },
      "50": { "$value": "#FFFBEB", "$type": "color" }
    },
    "danger": {
      "600": { "$value": "#DC2626", "$type": "color" },
      "50": { "$value": "#FEF2F2", "$type": "color" }
    },
    "info": {
      "600": { "$value": "#2563EB", "$type": "color" },
      "50": { "$value": "#EFF6FF", "$type": "color" }
    },
    "status": {
      "$description": "One colour per order state. StatusBadge is the only consumer; screens never reference these directly.",
      "placed": {
        "$value": "#6B7280",
        "$type": "color",
        "$description": "Grey - waiting for restaurant acknowledgement"
      },
      "confirmed": {
        "$value": "#2563EB",
        "$type": "color",
        "$description": "Blue - accepted by the restaurant"
      },
      "preparing": {
        "$value": "#D97706",
        "$type": "color",
        "$description": "Amber - in the kitchen"
      },
      "readyForPickup": {
        "$value": "#7C3AED",
        "$type": "color",
        "$description": "Violet - waiting for a rider"
      },
      "assigned": {
        "$value": "#4F46E5",
        "$type": "color",
        "$description": "Indigo - delivery partner allotted"
      },
      "pickedUp": {
        "$value": "#0891B2",
        "$type": "color",
        "$description": "Cyan - food in the partner's hand"
      },
      "outForDelivery": {
        "$value": "#0D9488",
        "$type": "color",
        "$description": "Teal - on the way"
      },
      "delivered": {
        "$value": "#16A34A",
        "$type": "color",
        "$description": "Green - completed"
      },
      "cancelled": {
        "$value": "#DC2626",
        "$type": "color",
        "$description": "Red - terminal, cancelled by customer or admin"
      },
      "rejected": {
        "$value": "#B91C1C",
        "$type": "color",
        "$description": "Dark red - terminal, refused by restaurant"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$value": ["Inter", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "monospace"],
        "$type": "fontFamily"
      }
    },
    "size": {
      "2xs": { "$value": "11px", "$type": "dimension" },
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "3xl": { "$value": "30px", "$type": "dimension" },
      "4xl": { "$value": "36px", "$type": "dimension" }
    },
    "lineHeight": {
      "tight": { "$value": 1.2, "$type": "number" },
      "snug": { "$value": 1.35, "$type": "number" },
      "normal": { "$value": 1.55, "$type": "number" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semi": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    }
  },
  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "size": {
    "container": {
      "sm": { "$value": "640px", "$type": "dimension" },
      "md": { "$value": "768px", "$type": "dimension" },
      "lg": { "$value": "1024px", "$type": "dimension" },
      "xl": { "$value": "1200px", "$type": "dimension" }
    },
    "navbar": {
      "height": { "$value": "64px", "$type": "dimension" }
    },
    "sidebar": {
      "width": { "$value": "248px", "$type": "dimension" }
    },
    "breakpoint": {
      "sm": { "$value": "640px", "$type": "dimension" },
      "md": { "$value": "768px", "$type": "dimension" },
      "lg": { "$value": "1024px", "$type": "dimension" },
      "xl": { "$value": "1280px", "$type": "dimension" },
      "2xl": { "$value": "1536px", "$type": "dimension" }
    }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "6px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "16px", "$type": "dimension" },
    "2xl": { "$value": "24px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.05)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(17, 24, 39, 0.08)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        },
        {
          "color": "rgba(17, 24, 39, 0.04)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.08)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.12)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "28px",
        "spread": "0px"
      }
    },
    "focus": {
      "$type": "shadow",
      "$description": "Focus ring - brand 500 at 28% alpha, 3px spread.",
      "$value": {
        "color": "rgba(226, 55, 68, 0.28)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "3px"
      }
    }
  },
  "duration": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "200ms", "$type": "duration" },
    "slow": { "$value": "320ms", "$type": "duration" }
  },
  "easing": {
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" }
  },
  "zIndex": {
    "dropdown": { "$value": 1000, "$type": "number" },
    "sticky": { "$value": 1020, "$type": "number" },
    "drawer": { "$value": 1040, "$type": "number" },
    "modal": { "$value": 1050, "$type": "number" },
    "toast": { "$value": 1060, "$type": "number" }
  }
}
